+<!-- Passerelle JDC conservée : brouillons par chantier, documents PDF, fil d'actualités. -->
+<script>
+/* Passerelle JDC V16.0.23 : conserve le PDF local ET archive le PDF officiel
+   dans Documentation/FBM + fil d'actualite, via la session authentifiee JDC.
+   Aucune cle ni connexion Supabase de l'application FBM n'est modifiee. */
+window.jdcArchiverPDF = async function(doc, nomFichier, options={}) {
+  if (!new URLSearchParams(location.search).has('journal_session')) return {ok:true, mode:'autonome'};
+  const pont = window.JournalFBMChild;
+  if (!pont?.integrated) {
+    alert('Journal de chantier indisponible : PDF télécharge localement, mais NON archivé. Réouvrez FBM depuis votre chantier JDC.');
+    return {ok:false, error:'Pont Journal indisponible'};
+  }
+  try {
+    if (options.brouillon) {
+      const sauvegarde = await pont.persistBeforeArchive();
+      if (!sauvegarde?.ok) {
+        alert('Le brouillon JDC n\'est pas confirmé : ' + String(sauvegarde?.error||'Erreur') + '. PDF téléchargé, NON archivé.');
+        return {ok:false, error:'Brouillon non confirme'};
+      }
+    }
+    const resultat = await pont.archive(doc.output('blob'), nomFichier);
+    if (!resultat?.ok) {
+      alert('Le PDF a été téléchargé, mais l\'archivage dans Journal de chantier a échoué : ' + String(resultat?.error||'Erreur') + '. Réessayez avant de quitter.');
+      return {ok:false, error:resultat?.error || 'Archivage non confirme'};
+    }
+    return resultat;
+  } catch(e) {
+    alert('PDF téléchargé, mais archivage Journal non confirmé : ' + String(e?.message||e).slice(0,180));
+    return {ok:false, error:'Erreur archivage'};
+  }
+};
+</script>
